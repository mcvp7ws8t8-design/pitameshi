{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pitameshi",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // ISR/fetch キャッシュ用(Cloudflare の管理画面で作成した KV「NEXT_INC_CACHE_KV」)。
  "kv_namespaces": [
    {
      "binding": "NEXT_INC_CACHE_KV",
      "id": "198331420fc5451082465d20e7730aaf"
    }
  ],
  // SITE_URL・APIキーなどは vars に書かず、GitHub の Secrets に登録する(公開時に Workers の secret として渡す。.github/workflows/ci.yml)。
  "observability": {
    "enabled": true
  }
}
