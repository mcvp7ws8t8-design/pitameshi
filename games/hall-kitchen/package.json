{
  "name": "hall-kitchen",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite build --watch & wrangler dev",
    "build": "vite build",
    "test": "tsx --test src/shared/*.test.ts",
    "typecheck": "tsc -p tsconfig.shared.json && tsc -p tsconfig.server.json && tsc -p tsconfig.client.json",
    "deploy": "vite build && wrangler deploy",
    "build:artifact": "vite build -c vite.artifact.config.ts && node scripts/make-artifact.mjs",
    "build:gallery": "vite build -c vite.gallery.config.ts && node scripts/make-gallery.mjs"
  },
  "dependencies": {
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261006.1",
    "@types/node": "^22.10.0",
    "@types/three": "^0.170.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "wrangler": "^4.0.0"
  }
}
