# ローカル開発用。`.env.local` にコピーして値を入れる(.env.local は Git に含めない)。
# 本番(Cloudflare)では `npx wrangler secret put <名前>` で登録する。

# サイトの公開URL(サイトマップ・共有URL・canonical に使う)
SITE_URL=http://localhost:3000

# ホットペッパーグルメAPIキー(https://webservice.recruit.co.jp/register で取得)
# 空のままなら仮データ(src/lib/hotpepper/fixtures.ts)で動く
HOTPEPPER_API_KEY=

# バリューコマースのアフィリエイトリンク。{URL} の部分に店舗ページのURL(エンコード済み)が入る。
# 例: https://ck.jp.ap.valuecommerce.com/servlet/referral?sid=XXXX&pid=YYYY&vc_url={URL}
# 提携後に管理画面の「MyLink」などで発行された形式に合わせて設定する。空なら店舗URLへ直接リンク。
AFFILIATE_URL_TEMPLATE=

# Supabase(OSMカフェ・独自属性・クリック記録)。空ならカフェは仮データ、クリック記録はログ出力のみ。
SUPABASE_URL=
# ブラウザに出さないサーバー専用キー。読み書き両方に使う(サーバー側でのみ参照)。
SUPABASE_SERVICE_ROLE_KEY=

# 問い合わせフォーム(Googleフォームなど外部フォームのURL)
CONTACT_FORM_URL=

# 運営者のハンドルネーム
OPERATOR_NAME=ぴためし運営

# Google アナリティクス(GA4)の測定ID。例: G-XXXXXXXXXX(空なら読み込まない)
NEXT_PUBLIC_GA_ID=
